# Copy to .env and fill in. Generate the password with: openssl rand -base64 18
ELASTIC_PASSWORD=CHANGE-ME
# Auto-populated by setup.sh on first run (do not lose after first boot!):
# KIBANA_TOKEN / FLEET_TOKEN / KIBANA_ENC_KEY
# Optional: post alerts to a webhook (e.g. Discord relay, n8n, your own listener)
# WEBHOOK_URL=http://your-listener:9000/alert
# The IP agents ship to (the Kali's WireGuard-side IP on the lab network)
# STACK_IP=10.x.x.x
